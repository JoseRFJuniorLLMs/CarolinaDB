// Fixture: causal_ship (SPEC-003 §12)
// immutable PaymentConfirmed(order, payment); ship requires the committed fact; emits ShipmentCreated
ENUM OrderState { Created, Shipped }

RECORD Order { id: Uuid PRIMARY KEY, state: OrderState }
RECORD PaymentConfirmed IMMUTABLE { order: Uuid PRIMARY KEY, payment: Uuid }
RECORD ShipmentCreated IMMUTABLE { order: Uuid PRIMARY KEY, shipment: Uuid }

INVARIANT order_transitions { TRANSITION o IN Order : o.state FROM Created TO Shipped }
INVARIANT ship_requires_payment { REQUIRES ship(order) NEEDS PaymentConfirmed(order) }

OPERATION confirm_payment(order: Uuid, payment: Uuid) VERSION 1 {
  REQUIRE true
  READ {}
  EFFECT { EMIT PaymentConfirmed { order: order, payment: payment } }
  ENSURE true
  RETURN { order: order, payment: payment }
  CONTRACT {
    atomicity: WholeInvocation,
    input_visibility: CausalContext,
    result_semantics: Receipt,
    result_scope: PerKey(PaymentConfirmed[order]),
    session: { CausalDependencies },
    session_scope: ReplicationGroup("orders"),
    durability: LocalStable,
    partition_outcomes: { Wait },
    refusal_semantics: MissingDependency,
    commitment: FinalWhenDurable,
    request_namespace: "orders"
  }
}

OPERATION ship(order: Uuid, shipment: Uuid) VERSION 1 {
  REQUIRE true
  READ { o = Order[order] }
  EFFECT {
    EMIT ShipmentCreated { order: order, shipment: shipment },
    ADVANCE Order[order].state FROM Created TO Shipped
  }
  ENSURE Order[order].state == OrderState::Shipped
  RETURN { order: order, shipment: shipment }
  CONTRACT {
    atomicity: WholeInvocation,
    input_visibility: CausalContext,
    result_semantics: Receipt,
    result_scope: PerKey(Order[order]),
    session: { CausalDependencies },
    session_scope: ReplicationGroup("orders"),
    durability: LocalStable,
    partition_outcomes: { Wait },
    refusal_semantics: MissingDependency,
    commitment: FinalWhenDurable,
    request_namespace: "orders"
  }
}
